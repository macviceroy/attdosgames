# Fase 1: exportar no shell; arquivo .env NÃO é carregado automaticamente.
ATT_DATA_DIR=data
# Fase 2: placeholders documentais, adaptadores ainda NÃO implementados.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=pt-BR-FranciscaNeural
# Alternativa Google Cloud TTS via Application Default Credentials, com voz pt-BR.
GOOGLE_APPLICATION_CREDENTIALS=
# Fase 3: armazenar tokens em secret manager, nunca neste arquivo versionado.
YOUTUBE_OAUTH_CLIENT_FILE=
YOUTUBE_OAUTH_TOKEN_FILE=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
